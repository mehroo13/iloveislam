# Supabase — optional accounts & cloud sync (Stage 7)
# Copy to .env.local and fill in from the Supabase dashboard.
# NEVER commit .env.local or any real key to the repo.
# See docs/SUPABASE_SETUP.md for the exact setup steps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used ONLY by app/api/account/delete/route.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
